{
  "$schema": "https://json.xibo.dev/schemas/release-harness/topology-v1.json",
  "schema_version": "1.0.0",
  "product_slug": "tiny-monorepo",
  "topology_type": "monorepo",
  "nodes": [
    {
      "id": "backend",
      "path": "backend",
      "type": "api",
      "served_origin_id": "tiny-api",
      "health_probe": {
        "type": "http",
        "scheme": "http",
        "host": "127.0.0.1",
        "port": 8000,
        "path": "/health",
        "expected_status": 200
      }
    },
    {
      "id": "frontend",
      "path": "frontend",
      "type": "browser_app",
      "served_origin_id": "tiny-web",
      "depends_on": ["backend"],
      "health_probe": {
        "type": "http",
        "scheme": "http",
        "host": "127.0.0.1",
        "port": 3000,
        "path": "/",
        "expected_status": 200
      }
    }
  ]
}
