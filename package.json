{
  "name": "release-harness-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic, versioned quality-gate and local UAT release harness for software products",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:site": "node scripts/build-public-site.mjs",
    "test:docs": "node tests/docs/public-site.test.mjs",
    "test:release": "node scripts/check-release-version.mjs && node --test tests/package/release-version.test.mjs",
    "test": "npm run test:all",
    "test:schemas": "node packages/release-harness-schemas/test.js",
    "test:core": "node packages/release-harness-core/test/index.js",
    "test:neutral": "node tests/neutral/neutral-fixtures.test.js",
    "test:smoke": "node tests/smoke/run-harness-acceptance.js",
    "test:install": "node tests/package/test-installability.mjs",
    "test:all": "npm run test:release && npm run test:docs && npm run test:schemas && npm run test:core && npm run test:neutral && npm run test:smoke && npm run test:install"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xibodev/release-harness.git"
  }
}
