    "./acceptance": "./src/acceptance.js",
    "./attribution": "./src/attribution.js",
    "./bindings": "./src/bindings.js",
    "./run-manifest": "./src/run-manifest.js",
    "./validator": "./src/validator.js",
    "./sealer": "./src/sealer.js",
    "./materializer": "./src/materializer.js",
    "./probes": "./src/probes.js",
    "./redactor": "./src/redactor.js",
    "./adjudicate": "./src/adjudicate.js",
    "./execute": "./src/execute.js"
