{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.xibo.dev/schemas/release-harness/run-manifest-v1.json",
  "title": "ReleaseHarnessRunManifest",
  "description": "What was exercised, where, and what came of it. Four identities are kept apart deliberately -- which proposition, where it was exercised, which revision of the subject, and what was observed -- because folding them into one digest makes 'did the promise change?' and 'did the port change?' indistinguishable afterwards.",
  "type": "object",
  "required": ["schema_version", "run_id", "bindings", "evidence", "certification", "verdict"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "run_id": { "type": "string", "minLength": 1 },
    "harness_version": { "type": "string" },
    "started_at": { "type": "string" },
    "completed_at": { "type": "string" },

    "contract": {
      "description": "The accepted proposition this run exercised. Null for an exploratory run, which genuinely has none -- an empty digest would imply otherwise.",
      "oneOf": [
        {
          "type": "object",
          "required": ["digest"],
          "additionalProperties": false,
          "properties": {
            "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "subject_id": { "type": "string" },
            "requires": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["ref", "digest"],
                "additionalProperties": false,
                "properties": {
                  "ref": { "type": "string" },
                  "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
              }
            }
          }
        },
        { "type": "null" }
      ]
    },

    "bindings": {
      "description": "Where the run looked. A sibling of the contract, never folded into it.",
      "type": "object",
      "required": ["digest", "targets"],
      "additionalProperties": false,
      "properties": {
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "targets": {
          "description": "INTENTIONAL MAP: keys are the symbolic target names an assertion may reference, which are authored per contract and cannot be enumerated in a schema.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "sources": {
      "description": "INTENTIONAL MAP: subject revisions keyed by subject id.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },

    "evidence": {
      "type": "object",
      "required": ["manifest_sha256"],
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },

    "certification": {
      "description": "Whether this run was entitled to certify, recorded so eligibility is auditable after the fact.",
      "type": "object",
      "required": ["mode", "eligible"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["CERTIFYING", "EXPLORATORY"] },
        "eligible": { "type": "boolean" },
        "ineligible_reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "detail"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string" },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },

    "verdict": {
      "type": "object",
      "required": ["digest"],
      "additionalProperties": false,
      "properties": {
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status": { "enum": ["PASS", "FAIL", "UNPROVEN"] }
      }
    }
  }
}
