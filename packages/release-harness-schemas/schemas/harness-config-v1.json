{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.xibo.dev/schemas/release-harness/harness-config-v1.json",
  "title": "ReleaseHarnessConfiguration",
  "description": "Product configuration for release harness execution",
  "type": "object",
  "required": ["schema_version", "product_slug", "harness_version", "port_block"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "product_slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "harness_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "port_block": {
      "type": "object",
      "required": ["start", "range"],
      "properties": {
        "start": { "type": "integer", "minimum": 1024, "maximum": 65000 },
        "range": { "type": "integer", "minimum": 10, "maximum": 500 }
      }
    },
    "timeouts": {
      "type": "object",
      "properties": {
        "health_check_seconds": { "type": "integer", "default": 60 },
        "scenario_timeout_ms": { "type": "integer", "default": 60000 },
        "run_timeout_seconds": { "type": "integer", "default": 600 }
      }
    },
    "network_policy": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["sealed", "open"], "default": "sealed" },
        "allowed_egress": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "port"],
            "properties": {
              "host": { "type": "string" },
              "port": { "type": "integer" },
              "purpose": { "type": "string" },
              "declared_in": { "type": "string" }
            }
          }
        }
      }
    },
    "security_headers": {
      "type": "object",
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "forbidden": { "type": "array", "items": { "type": "string" } },
        "exact": { "type": "object", "additionalProperties": { "type": "string" } },
        "normalized": { "type": "object", "additionalProperties": { "type": "string" } },
        "environment_substitutions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "pr_gate": {
      "type": "object",
      "description": "Level 1 PR gate commands executed by check-pr in the project working directory",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cmd"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "cmd": { "type": "string" },
              "timeout_seconds": { "type": "integer", "minimum": 1 },
              "expected_exit_code": { "type": "integer" }
            }
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "properties": {
        "topology": { "type": "string", "default": ".release-harness/topology.json" },
        "origins": { "type": "string", "default": ".release-harness/origins.json" },
        "scenarios": { "type": "string", "default": ".release-harness/scenarios" },
        "fixtures": { "type": "string", "default": ".release-harness/fixtures" },
        "brand_contract": { "type": "string", "default": ".release-harness/brand-contract.json" },
        "waivers": { "type": "string", "default": ".release-harness/waivers.json" }
      }
    }
  }
}
