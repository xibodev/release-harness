{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.xibo.dev/schemas/release-harness/origins-v1.json",
  "title": "ReleaseHarnessOrigins",
  "description": "Multi-origin served surface contracts for browser apps, APIs, and workers",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["origin_id", "type", "auth", "url_source", "route_families", "safe_for_live", "evidence"],
    "properties": {
      "origin_id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "type": {
        "type": "string",
        "enum": ["browser_app", "api", "worker"]
      },
      "auth": {
        "type": "string"
      },
      "url_source": {
        "type": "string"
      },
      "route_families": {
        "type": "array",
        "items": { "type": "string" }
      },
      "safe_for_live": {
        "type": "boolean"
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      },
      "security_headers": {
        "type": "object",
        "properties": {
          "required": { "type": "array", "items": { "type": "string" } },
          "forbidden": { "type": "array", "items": { "type": "string" } },
          "exact": { "type": "object", "additionalProperties": { "type": "string" } },
          "normalized": { "type": "object", "additionalProperties": { "type": "string" } },
          "environment_substitutions": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    }
  }
}
