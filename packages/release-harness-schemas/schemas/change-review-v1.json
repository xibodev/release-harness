{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.xibo.dev/schemas/release-harness/change-review-v1.json",
  "title": "ReleaseHarnessChangeReview",
  "description": "A semantic review of whether an existing accepted proposition remains appropriate for an exact set of source identities. Lifecycle metadata around the contract; never part of proposition identity.",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "contract",
    "authoring_provenance",
    "sources",
    "facts",
    "impact",
    "questions",
    "conclusion",
    "proposed"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "mode": {
      "enum": [
        "baseline",
        "change"
      ]
    },
    "contract": {
      "type": "object",
      "required": [
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/definitions/digest"
        }
      }
    },
    "authoring_provenance": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "path",
            "digest"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "established"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "$ref": "#/definitions/digest"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "not_available"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/source"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/fact"
      }
    },
    "impact": {
      "type": "object",
      "required": [
        "assertions",
        "requires",
        "possible_binding_changes"
      ],
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/assertionImpact"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/requireImpact"
          }
        },
        "possible_binding_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/question"
      }
    },
    "conclusion": {
      "type": "object",
      "required": [
        "action",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "reuse_contract",
            "rebind",
            "reauthor",
            "block"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "proposed": {
      "description": "Attribution for the mutable proposal. Excluded from immutable review identity.",
      "type": "object",
      "required": [
        "by",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Immutable semantic review identity; excluded from its own digest."
    }
  },
  "definitions": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "source_id",
            "status",
            "repository_identity",
            "head_commit",
            "head_tree",
            "reviewed_source_digest",
            "changed_paths"
          ],
          "additionalProperties": false,
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "const": "established"
            },
            "repository_identity": {
              "type": "string",
              "minLength": 1
            },
            "base_ref": {
              "type": "string"
            },
            "base_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "merge_base": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "head_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "head_tree": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "reviewed_source_digest": {
              "$ref": "#/definitions/digest"
            },
            "changed_paths": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/changedPath"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "source_id",
            "status",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "const": "not_established"
            },
            "repository_identity": {
              "type": "string"
            },
            "base_ref": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "changedPath": {
      "type": "object",
      "required": [
        "status",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed",
            "type_changed"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "old_blob": {
          "type": "string"
        },
        "new_blob": {
          "type": "string"
        }
      }
    },
    "fact": {
      "type": "object",
      "required": [
        "id",
        "claim",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "observed",
            "observed_absent",
            "asserted_absent",
            "inferred",
            "not_established"
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "roots": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "completed": {
              "type": "boolean"
            },
            "asserted_by": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "inferred"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "evidence"
            ],
            "properties": {
              "evidence": {
                "required": [
                  "source"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed_absent"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "evidence"
            ],
            "properties": {
              "evidence": {
                "required": [
                  "method",
                  "roots",
                  "completed"
                ],
                "properties": {
                  "completed": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "asserted_absent"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "evidence"
            ],
            "properties": {
              "evidence": {
                "required": [
                  "asserted_by"
                ]
              }
            }
          }
        }
      ]
    },
    "assertionImpact": {
      "type": "object",
      "required": [
        "id",
        "impact",
        "supported_by"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "enum": [
            "unchanged",
            "changed",
            "weakened_evidence",
            "not_established"
          ]
        },
        "supported_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requireImpact": {
      "type": "object",
      "required": [
        "ref",
        "digest",
        "impact",
        "supported_by"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/definitions/digest"
        },
        "impact": {
          "enum": [
            "unchanged",
            "changed",
            "not_established"
          ]
        },
        "supported_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "question",
        "blocking"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        },
        "resolution": {
          "type": "string",
          "minLength": 1
        },
        "resolved_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "dependencies": {
        "resolution": [
          "resolved_by"
        ],
        "resolved_by": [
          "resolution"
        ]
      }
    }
  }
}
