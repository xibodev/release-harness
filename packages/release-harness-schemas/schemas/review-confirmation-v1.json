{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.xibo.dev/schemas/release-harness/review-confirmation-v1.json",
  "title": "ReleaseHarnessReviewConfirmation",
  "description": "Attributable confirmation of one exact immutable review identity. Separate from semantic review identity just as acceptance attribution is separate from contract identity.",
  "type": "object",
  "required": ["schema_version", "review_digest", "events"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "review_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["by", "at"],
        "additionalProperties": false,
        "properties": {
          "by": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    }
  }
}
